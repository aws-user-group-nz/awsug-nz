---
/**
 * Site search via Pagefind (static index under /pagefind/ after build).
 * Ctrl/Cmd+K or the header button opens a modal; results load in-browser.
 */
import Icon from './Icon.astro';

const pagefindBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind`;
const pagefindSrc = `${pagefindBase}/pagefind.js`;
const pdfPagesSrc = `${pagefindBase}/pdf-pages.json`;
---

<button
  type="button"
  class="search-button"
  data-search-open
  aria-haspopup="dialog"
  title="Search (Ctrl K)"
>
  <Icon name="search" />
  <span class="search-button-label">Search</span>
  <kbd class="search-kbd" data-search-kbd aria-hidden="true">Ctrl K</kbd>
  <span class="visually-hidden">Open site search</span>
</button>

<dialog class="search-dialog" data-search-dialog aria-labelledby="search-dialog-title">
  <div class="search-panel">
    <div class="search-bar">
      <Icon name="search" class="search-bar-icon" />
      <input
        type="search"
        class="search-input"
        data-search-input
        id="site-search-input"
        placeholder="Search the site…"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        enterkeyhint="search"
      />
      <button type="button" class="search-close" data-search-close aria-label="Close search">
        <Icon name="close" />
      </button>
    </div>
    <h2 id="search-dialog-title" class="visually-hidden">Site search</h2>
    <p class="search-status" data-search-status role="status" aria-live="polite"></p>
    <ul class="search-results" data-search-results></ul>
  </div>
</dialog>

<style>
  .search-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    box-sizing: border-box;
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border: 1px solid rgb(255 255 255 / 28%);
    border-radius: 999px;
    background: transparent;
    color: var(--header-text);
    cursor: pointer;
    flex-shrink: 0;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .search-button:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgb(255 255 255 / 8%);
  }

  .search-button:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .search-button :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }

  .search-kbd {
    display: none;
    margin: 0;
    padding: 0.1rem 0.4rem;
    border: 1px solid rgb(255 255 255 / 28%);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--text-xs);
    line-height: 1.4;
    color: rgb(255 255 255 / 72%);
  }

  @media (min-width: 861px) {
    .search-kbd {
      display: inline-block;
    }
  }

  @media (max-width: 860px) {
    .search-button {
      width: 2.75rem;
      min-width: 2.75rem;
      padding: 0;
      justify-content: center;
    }

    .search-button-label,
    .search-kbd {
      display: none;
    }
  }

  .search-dialog {
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
  }

  .search-dialog::backdrop {
    background: var(--overlay);
  }

  .search-dialog[open] {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: min(12vh, 5rem) var(--space-4) var(--space-4);
  }

  .search-panel {
    width: min(36rem, 100%);
    max-height: min(80vh, 40rem);
    display: flex;
    flex-direction: column;
    background: var(--surface-raised);
    color: var(--text-primary);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .search-bar-icon {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    fill: var(--text-secondary);
  }

  .search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: var(--text-md);
    padding: var(--space-2) 0;
  }

  .search-input:focus {
    outline: none;
  }

  .search-input::placeholder {
    color: var(--text-secondary);
  }

  .search-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    min-width: 2.5rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .search-close:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
  }

  .search-close:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .search-close :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }

  .search-status {
    margin: 0;
    padding: var(--space-3) var(--space-4) 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .search-status:empty {
    display: none;
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: var(--space-2) 0 var(--space-3);
    overflow: auto;
  }

  .search-results :global(a) {
    display: block;
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    color: inherit;
    border-block: 1px solid transparent;
  }

  .search-results :global(a:hover),
  .search-results :global(a:focus-visible) {
    background: var(--surface-sunken);
    outline: none;
  }

  .search-results :global(.search-result-title) {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-weight: 600;
    color: var(--text-primary);
  }

  .search-results :global(.search-result-badge) {
    flex-shrink: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.05rem 0.35rem;
  }

  .search-results :global(.search-result-excerpt) {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .search-results :global(mark) {
    background: color-mix(in srgb, var(--accent) 35%, transparent);
    color: inherit;
    padding: 0 0.1em;
    border-radius: 2px;
  }
</style>

<script is:inline type="module" define:vars={{ pagefindSrc, pdfPagesSrc }}>
  (function () {
    var RESULT_LIMIT = 25;
    var pagefind = null;
    var loadPromise = null;
    /** @type {Record<string, string> | null} */
    var pdfPages = null;
    var pdfPagesPromise = null;

    function dialog() {
      return document.querySelector('[data-search-dialog]');
    }

    function input() {
      return document.querySelector('[data-search-input]');
    }

    function resultsEl() {
      return document.querySelector('[data-search-results]');
    }

    function statusEl() {
      return document.querySelector('[data-search-status]');
    }

    function applyShortcutHint() {
      var platform =
        (navigator.userAgentData && navigator.userAgentData.platform) ||
        navigator.platform ||
        '';
      var isApple = /Mac|iPhone|iPad|iPod/i.test(platform) || /Mac OS/i.test(navigator.userAgent);
      var hint = isApple ? '\u2318K' : 'Ctrl K';
      document.querySelectorAll('[data-search-kbd]').forEach(function (kbd) {
        kbd.textContent = hint;
      });
      document.querySelectorAll('[data-search-open]').forEach(function (btn) {
        btn.title = 'Search (' + hint + ')';
      });
    }

    function titleFromUrl(url) {
      try {
        var path = new URL(url, window.location.origin).pathname;
        var name = path.split('/').filter(Boolean).pop() || url;
        if (/\.pdf$/i.test(name)) {
          name = name.replace(/\.pdf$/i, '');
        }
        name = name
          .replace(/^awsugnz[-_]?/i, '')
          .replace(/[-_]+/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
        if (!name) return url;
        return name.replace(/\b[a-z]/g, function (ch) {
          return ch.toUpperCase();
        });
      } catch (e) {
        return url;
      }
    }

    function isPdfResult(item) {
      if (item.meta && item.meta.type === 'pdf') return true;
      return /\.pdf($|\?)/i.test(item.url || '');
    }

    function ensurePdfPages() {
      if (pdfPages) return Promise.resolve(pdfPages);
      if (!pdfPagesPromise) {
        pdfPagesPromise = fetch(pdfPagesSrc)
          .then(function (res) {
            return res.ok ? res.json() : {};
          })
          .then(function (data) {
            pdfPages = data && typeof data === 'object' ? data : {};
            return pdfPages;
          })
          .catch(function () {
            pdfPages = {};
            return pdfPages;
          });
      }
      return pdfPagesPromise;
    }

    function prepareResults(items, routes) {
      var prepared = items.map(function (item) {
        var fromPdf = isPdfResult(item);
        var href = fromPdf && routes[item.url] ? routes[item.url] : item.url;
        var opensFile = /\.pdf($|\?)/i.test(href);
        return {
          item: item,
          href: href,
          fromPdf: fromPdf,
          opensFile: opensFile,
          title: (item.meta && item.meta.title) || titleFromUrl(fromPdf ? item.url : href),
          excerpt: item.excerpt || '',
        };
      });

      // One row per destination: keep PDF-backed hit when both page + PDF match.
      var byHref = new Map();
      prepared.forEach(function (row) {
        var prev = byHref.get(row.href);
        if (!prev) {
          byHref.set(row.href, row);
          return;
        }
        if (row.fromPdf) {
          byHref.set(row.href, {
            item: row.item,
            href: row.href,
            fromPdf: true,
            opensFile: row.opensFile,
            title: prev.title || row.title,
            excerpt: row.excerpt || prev.excerpt,
          });
        } else if (prev.fromPdf) {
          byHref.set(row.href, {
            item: prev.item,
            href: prev.href,
            fromPdf: true,
            opensFile: prev.opensFile,
            title: row.title || prev.title,
            excerpt: prev.excerpt || row.excerpt,
          });
        }
      });
      return Array.from(byHref.values());
    }

    function ensurePagefind() {
      if (pagefind) return Promise.resolve(pagefind);
      if (!loadPromise) {
        loadPromise = import(pagefindSrc)
          .then(function (mod) {
            return mod.init().then(function () {
              pagefind = mod;
              return mod;
            });
          })
          .catch(function (err) {
            loadPromise = null;
            throw err;
          });
      }
      return loadPromise;
    }

    function setStatus(text) {
      var el = statusEl();
      if (el) el.textContent = text;
    }

    function clearResults() {
      var list = resultsEl();
      if (list) list.replaceChildren();
    }

    function closeSearch() {
      var d = dialog();
      if (d instanceof HTMLDialogElement && d.open) d.close();
    }

    function openSearch() {
      var d = dialog();
      var i = input();
      if (!d || !(d instanceof HTMLDialogElement)) return;
      if (!d.open) d.showModal();
      if (i) {
        i.focus();
        i.select();
      }
      ensurePagefind().catch(function () {});
      ensurePdfPages();
    }

    function runSearch(query) {
      var q = query.trim();
      clearResults();
      if (!q) {
        setStatus('');
        return;
      }

      setStatus('Searching\u2026');
      Promise.all([ensurePagefind(), ensurePdfPages()])
        .then(function (parts) {
          var pf = parts[0];
          var routes = parts[1];
          return pf.debouncedSearch(q).then(function (search) {
            return { search: search, routes: routes };
          });
        })
        .then(function (payload) {
          var search = payload.search;
          var routes = payload.routes;
          if (!search || !search.results) {
            setStatus('No results.');
            return;
          }
          if (search.results.length === 0) {
            setStatus('No results.');
            return;
          }

          var slice = search.results.slice(0, RESULT_LIMIT);
          return Promise.all(
            slice.map(function (r) {
              return r.data();
            }),
          ).then(function (data) {
            var list = resultsEl();
            if (!list) return;

            var rows = prepareResults(data, routes);
            var frag = document.createDocumentFragment();
            rows.forEach(function (row) {
              var li = document.createElement('li');
              var a = document.createElement('a');
              a.href = row.href;
              if (row.opensFile) {
                a.target = '_blank';
                a.rel = 'noopener noreferrer';
              }

              var title = document.createElement('span');
              title.className = 'search-result-title';
              var titleText = document.createElement('span');
              titleText.textContent = row.title;
              title.appendChild(titleText);
              if (row.fromPdf) {
                var badge = document.createElement('span');
                badge.className = 'search-result-badge';
                badge.textContent = 'PDF';
                title.appendChild(badge);
              }

              var excerpt = document.createElement('span');
              excerpt.className = 'search-result-excerpt';
              excerpt.innerHTML = row.excerpt;

              a.append(title, excerpt);
              a.addEventListener('click', closeSearch);
              li.appendChild(a);
              frag.appendChild(li);
            });
            list.appendChild(frag);

            var more = search.results.length - slice.length;
            setStatus(
              more > 0
                ? 'Showing ' + rows.length + ' of ' + search.results.length + ' results'
                : rows.length + ' result' + (rows.length === 1 ? '' : 's'),
            );
          });
        })
        .catch(function () {
          setStatus('Search is temporarily unavailable. Please try again later.');
        });
    }

    if (!globalThis.__awsugSearchBound) {
      globalThis.__awsugSearchBound = true;

      document.addEventListener('click', function (event) {
        var t = event.target;
        if (!(t instanceof Element)) return;
        if (t.closest('[data-search-open]')) {
          openSearch();
          return;
        }
        if (t.closest('[data-search-close]')) closeSearch();
      });

      document.addEventListener('keydown', function (event) {
        var metaK = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k';
        if (metaK) {
          event.preventDefault();
          var d = dialog();
          if (d instanceof HTMLDialogElement && d.open) closeSearch();
          else openSearch();
          return;
        }
        if (event.key === 'Escape') {
          var d2 = dialog();
          if (d2 instanceof HTMLDialogElement && d2.open) {
            event.preventDefault();
            closeSearch();
          }
        }
      });

      document.addEventListener('input', function (event) {
        var t = event.target;
        if (!(t instanceof HTMLInputElement) || !t.matches('[data-search-input]')) return;
        runSearch(t.value);
      });

      document.addEventListener('astro:page-load', function () {
        applyShortcutHint();
        var d = dialog();
        if (d instanceof HTMLDialogElement && d.open) closeSearch();
      });
    }

    applyShortcutHint();
  })();
</script>
