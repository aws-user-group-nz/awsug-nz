---
/**
 * Inline SVG icons, replacing the Font Awesome CDN the reference sites load.
 * Inlining keeps icons on our own origin with no extra request and no
 * third-party dependency, and lets them inherit `currentcolor`.
 */
export type IconName =
  | 'discord'
  | 'linkedin'
  | 'facebook'
  | 'youtube'
  | 'twitch'
  | 'calendar'
  | 'chevron'
  | 'external'
  | 'menu'
  | 'close'
  | 'sun'
  | 'moon'
  | 'location'
  | 'clock'
  | 'arrow-right';

interface Props {
  name: IconName;
  class?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { name, class: className = '', size = 'md' } = Astro.props;

const sizeClass = size === 'sm' ? 'icon-sm' : size === 'lg' ? 'icon-lg' : '';

/** viewBox differs for Font Awesome–sourced sun/moon icons. */
const viewBoxes: Partial<Record<IconName, string>> = {
  sun: '0 0 512 512',
  moon: '0 0 384 512',
};

