---

<svg
  class={`icon ${sizeClass} ${className}`.trim()}
  viewBox={viewBoxes[name] ?? '0 0 24 24'}
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>
