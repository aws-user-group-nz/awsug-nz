---
import Icon from './Icon.astro';

/**
 * People lists (officers, history cohort, meetup leads).
 *
 * variant:
 * - officers — portrait grid (current About officers)
 * - table    — dense rows with photo (History)
 * - compact  — dense cards (meetup leads; fine without photos)
 *
 * Optional JSON fields: photo, linkedin, url, role, terms[{start,ceased}]
 */
interface Term {
  start: string;
  ceased: string;
}

interface Person {
  name: string;
  role?: string;
  company?: string;
  photo?: string;
  linkedin?: string;
  url?: string;
  terms?: Term[];
}

interface Props {
  people: Person[];
  variant?: 'officers' | 'table' | 'compact';
}

const { people, variant = 'compact' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const termFormat = new Intl.DateTimeFormat('en-NZ', {
  month: 'short',
  year: 'numeric',
  timeZone: 'Pacific/Auckland',
});

function photoSrc(person: Person): string | undefined {
  if (!person.photo) return undefined;
  if (/^https?:\/\//i.test(person.photo)) return person.photo;
  return `${base}/people/${person.photo}`;
}

function initials(name: string): string {
  const parts = name.trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return '?';
  if (parts.length === 1) return parts[0]!.slice(0, 2).toUpperCase();
  return `${parts[0]![0] ?? ''}${parts[parts.length - 1]![0] ?? ''}`.toUpperCase();
}

function formatTerm(term: Term): string {
  const start = termFormat.format(new Date(`${term.start}T12:00:00+12:00`));
  const ceased = termFormat.format(new Date(`${term.ceased}T12:00:00+12:00`));
  return `${start} – ${ceased}`;
}

function termsLabel(person: Person): string | undefined {
  if (!person.terms?.length) return undefined;
  return person.terms.map(formatTerm).join('; ');
}

function subtitle(person: Person): string | undefined {
  const parts: string[] = [];
  if (person.role) parts.push(person.role);
  if (person.company) parts.push(person.company);
  const terms = termsLabel(person);
  if (terms && variant !== 'table') parts.push(terms);
  return parts.length > 0 ? parts.join(' · ') : undefined;
}

const avatarSize = variant === 'officers' ? 112 : 40;
---

{
  variant === 'table' ? (
    <ul class="roster" role="list">
      <li class="roster-head" aria-hidden="true">
        <span class="roster-person">Person</span>
        <span class="roster-role">Role</span>
      </li>
      {people.map((person) => {
        const src = photoSrc(person);
        return (
          <li class="roster-row">
            <div class="roster-person">
              <span class="roster-avatar">
                {src ? (
                  <img
                    src={src}
                    alt=""
                    width={avatarSize}
                    height={avatarSize}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="roster-initials" aria-hidden="true">
                    {initials(person.name)}
                  </span>
                )}
              </span>
              <span class="roster-who">
                <span class="roster-name-row">
                  <span class="roster-name">{person.name}</span>
                  {(person.linkedin || person.url) && (
                    <span class="roster-links">
                      {person.linkedin && (
                        <a
                          href={person.linkedin}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`${person.name} on LinkedIn`}
                        >
                          <Icon name="linkedin" size="sm" />
                        </a>
                      )}
                      {person.url && (
                        <a
                          href={person.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`${person.name} website`}
                        >
                          <Icon name="external" size="sm" />
                        </a>
                      )}
                    </span>
                  )}
                </span>
                {person.company && (
                  <span class="roster-company">{person.company}</span>
                )}
              </span>
            </div>
            <div class="roster-role">{person.role ?? 'Member'}</div>
          </li>
        );
      })}
    </ul>
  ) : (
    <ul class:list={['people', `people-${variant}`]}>
      {people.map((person) => {
        const src = photoSrc(person);
        const line = subtitle(person);
        const hasLinks = Boolean(person.linkedin || person.url);

        return (
          <li class="person">
            <div class="person-avatar" data-photo={src ? 'true' : undefined}>
              {src ? (
                <img
                  src={src}
                  alt=""
                  width={avatarSize}
                  height={avatarSize}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="person-initials" aria-hidden="true">
                  {initials(person.name)}
                </span>
              )}
            </div>

            <div class="person-meta">
              <p class="person-name">{person.name}</p>
              {line && <p class="person-line">{line}</p>}
            </div>

            {hasLinks && (
              <p class="person-links">
                {person.linkedin && (
                  <a
                    href={person.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${person.name} on LinkedIn`}
                  >
                    <Icon name="linkedin" size="sm" />
                  </a>
                )}
                {person.url && (
                  <a
                    href={person.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${person.name} website`}
                  >
                    <Icon name="external" size="sm" />
                  </a>
                )}
              </p>
            )}
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .people {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* —— Roster rows (History) —— */
  .roster {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface);
  }

  .roster-head,
  .roster-row {
    display: grid;
    grid-template-columns: minmax(12rem, 1.6fr) minmax(6rem, 0.8fr);
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
  }

  .roster-head {
    background: var(--surface-sunken);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  .roster-row + .roster-row {
    border-top: 1px solid var(--border);
  }

  .roster-person {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }

  .roster-avatar {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--surface-sunken);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--accent) 65%, transparent);
  }

  .roster-avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

  .roster-initials {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-secondary);
  }

  .roster-who {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .roster-name-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .roster-name {
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .roster-company {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .roster-role {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .roster-links {
    display: inline-flex;
    flex-shrink: 0;
    gap: var(--space-2);
  }

  .roster-links a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    min-width: 44px;
    min-height: 44px;
    color: var(--accent-text);
    border-radius: var(--radius-sm);
  }

  .roster-links a:hover,
  .roster-links a:focus-visible {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .roster-head {
      display: none;
    }

    .roster-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
      padding-block: var(--space-4);
    }

    .roster-role {
      padding-left: calc(2.5rem + var(--space-3));
    }

    .roster-role::before {
      content: 'Role · ';
      font-weight: 600;
    }
  }

  /* —— Officers: Oceania-like portrait grid —— */
  .people-officers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: var(--space-6) var(--space-4);
    justify-items: center;
    max-width: 44rem;
    margin-inline: auto;
  }

  .people-officers .person {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 10rem;
  }

  .people-officers .person-avatar {
    width: 6.5rem;
    height: 6.5rem;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(
      135deg,
      var(--accent) 0%,
      color-mix(in srgb, var(--accent) 50%, #f0c14b) 100%
    );
  }

  .people-officers .person-avatar img,
  .people-officers .person-initials {
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  .people-officers .person-avatar img {
    display: block;
    object-fit: cover;
    object-position: center 20%;
    background: var(--surface-sunken);
  }

  .people-officers .person-initials {
    display: grid;
    place-items: center;
    background: var(--surface);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-secondary);
  }

  .people-officers .person-meta {
    margin-top: var(--space-3);
  }

  .people-officers .person-name {
    font-weight: 700;
    font-size: var(--text-sm);
    line-height: 1.3;
  }

  .people-officers .person-line {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .people-officers .person-links {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    margin-top: var(--space-2);
  }

  /* —— Compact (members / leads) —— */
  .people-compact {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-2);
  }

  .people-compact .person {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .people-compact .person:hover,
  .people-compact .person:focus-within {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  .people-compact .person-avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--surface-sunken);
  }

  .people-compact .person-avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .people-compact .person-initials {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }

  .people-compact .person-meta {
    min-width: 0;
  }

  .people-compact .person-name {
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1.25;
  }

  .people-compact .person-line {
    margin-top: 1px;
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.35;
  }

  .people-compact .person-links {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  .person-links a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    min-width: 44px;
    min-height: 44px;
    color: var(--accent-text);
    border-radius: var(--radius-sm);
  }

  .person-links a:hover,
  .person-links a:focus-visible {
    color: var(--accent);
  }

  .person-links a:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
