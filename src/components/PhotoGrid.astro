---
interface Props {
  photos: string[];
  /** Absolute base URL for the year's directory, no trailing slash. */
  dirUrl: string;
  year: number;
  /** Photos revealed per batch. */
  batchSize?: number;
}

const { photos, dirUrl, year, batchSize = 60 } = Astro.props;

const batches: string[][] = [];
for (let i = 0; i < photos.length; i += batchSize) {
  batches.push(photos.slice(i, i + batchSize));
}
---

<div class="gallery" data-gallery data-pagefind-ignore>
  {
    /*
      Every photo is in the HTML, so the page is genuinely indexable and works
      without JavaScript. Batches after the first are `hidden`, and a hidden
      lazy image is not fetched until it is revealed — which is what keeps a
      350-photo year from pulling 200MB on load.
    */
  }
  {
    batches.map((batch, index) => (
      <ul class="photo-list" hidden={index > 0} data-batch={index}>
        {batch.map((file, offset) => {
          const position = index * batchSize + offset + 1;
          return (
            <li>
              <button
                type="button"
                class="photo"
                data-photo-src={`${dirUrl}/${file}`}
                data-photo-file={file}
                data-photo-index={position}
              >
                <img
                  src={`${dirUrl}/${file}`}
                  alt={`AWS Community Day ${year} — photo ${position} of ${photos.length}`}
                  loading="lazy"
                  decoding="async"
                />
              </button>
            </li>
          );
        })}
      </ul>
    ))
  }

  {
    batches.length > 1 && (
      <div class="gallery-more" data-gallery-more>
        <button type="button" class="btn btn-outline" data-gallery-more-button>
          Show more photos
        </button>
        <p class="gallery-count" data-gallery-count role="status">
          Showing {Math.min(batchSize, photos.length)} of {photos.length}
        </p>
      </div>
    )
  }
</div>

{/*
  Archive-style lightbox: full-viewport centre, circular prev/next, caption
  as "N / total - filename". Mirrors the live gallery at
  /communitydays/archive/photos/YYYY.
*/}
<dialog
  class="lightbox"
  data-lightbox
  aria-label={`AWS Community Day ${year} photo viewer`}
>
  <button
    type="button"
    class="lightbox-close"
    data-lightbox-close
    aria-label="Close photo viewer"
  >
    &times;
  </button>

  <div class="lightbox-stage">
    <button
      type="button"
      class="lightbox-nav lightbox-prev"
      data-lightbox-prev
      aria-label="Previous photo"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"></path>
      </svg>
    </button>

    <figure class="lightbox-figure">
      <img data-lightbox-image alt="" />
      <figcaption class="lightbox-caption" data-lightbox-caption></figcaption>
    </figure>

    <button
      type="button"
      class="lightbox-nav lightbox-next"
      data-lightbox-next
      aria-label="Next photo"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"></path>
      </svg>
    </button>
  </div>
</dialog>

<noscript>
  <style>
    /* Without JS there is no "show more" control, so reveal everything. */
    .photo-list[hidden] {
      display: grid !important;
    }

    .gallery-more {
      display: none;
    }
  </style>
</noscript>

<style>
  .photo-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .photo-list + .photo-list {
    margin-top: var(--space-3);
  }

  .photo {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: var(--surface-sunken);
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: zoom-in;
  }

  /*
    Fixed aspect ratio reserves the box before the image arrives, so the grid
    never shifts. The archive manifest carries no dimensions, so this is the
    only way to avoid layout shift today; a richer manifest would let us use
    each photo's real ratio instead.
  */
  .photo img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .photo:hover img {
    transform: scale(1.04);
  }

  .gallery-more {
    margin-top: var(--space-6);
    text-align: center;
  }

  .gallery-count {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* Full-viewport lightbox, matching the live archive viewer. */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    margin: 0;
    padding: var(--space-4);
    border: none;
    background: transparent;
    color: var(--white);
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 85%);
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-stage {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    width: min(96vw, 1400px);
    max-height: 94vh;
  }

  .lightbox-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    min-width: 0;
    max-height: 94vh;
  }

  .lightbox-figure img {
    max-width: 100%;
    max-height: calc(94vh - 3rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-md);
    background: var(--ink-900);
    box-shadow: var(--shadow-lg);
  }

  .lightbox-caption {
    margin: 0;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--grey-200);
    word-break: break-all;
  }

  .lightbox-nav {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgb(255 255 255 / 18%);
    color: var(--white);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .lightbox-nav:hover {
    background: var(--accent);
    color: var(--text-on-accent);
  }

  .lightbox-nav:focus-visible,
  .lightbox-close:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .lightbox-nav svg {
    width: 28px;
    height: 28px;
    fill: currentcolor;
  }

  .lightbox-close {
    position: fixed;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 1;
    width: 44px;
    height: 44px;
    font-size: var(--text-2xl);
    line-height: 1;
    background: rgb(0 0 0 / 55%);
    color: var(--white);
    border: none;
    border-radius: 50%;
    cursor: pointer;
  }

  .lightbox-close:hover {
    background: var(--accent);
    color: var(--text-on-accent);
  }

  @media (max-width: 720px) {
    .lightbox {
      padding: var(--space-2);
    }

    .lightbox-stage {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto;
      width: 100%;
      gap: var(--space-2);
    }

    .lightbox-figure {
      grid-row: 1;
      grid-column: 1;
    }

    .lightbox-nav {
      position: fixed;
      top: 50%;
      transform: translateY(-50%);
      width: 44px;
      height: 44px;
      min-width: 44px;
      min-height: 44px;
      background: rgb(0 0 0 / 55%);
    }

    .lightbox-prev {
      left: var(--space-2);
    }

    .lightbox-next {
      right: var(--space-2);
    }

    .lightbox-figure img {
      max-height: calc(94vh - 4rem);
    }
  }
</style>

<script>
  function bindGallery() {
    const gallery = document.querySelector<HTMLElement>('[data-gallery]');
    if (!gallery || gallery.dataset.galleryBound === 'true') return;
    gallery.dataset.galleryBound = 'true';

    const batches = Array.from(
      gallery.querySelectorAll<HTMLElement>('[data-batch]')
    );
    const moreBox = gallery.querySelector<HTMLElement>('[data-gallery-more]');
    const moreButton = gallery.querySelector<HTMLButtonElement>(
      '[data-gallery-more-button]'
    );
    const count = gallery.querySelector<HTMLElement>('[data-gallery-count]');

    const total = gallery.querySelectorAll('[data-photo-src]').length;
    let revealed = 1;

    moreButton?.addEventListener('click', () => {
      const next = batches[revealed];
      if (!next) return;
      next.hidden = false;
      revealed += 1;

      const shown = gallery.querySelectorAll(
        '[data-batch]:not([hidden]) [data-photo-src]'
      ).length;
      if (count) count.textContent = `Showing ${shown} of ${total}`;

      if (revealed >= batches.length && moreBox) moreBox.hidden = true;

      // Move focus to the first newly revealed photo so keyboard users are not
      // left on a button that has just disappeared.
      next.querySelector<HTMLButtonElement>('[data-photo-src]')?.focus();
    });

    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const caption = dialog?.querySelector<HTMLElement>('[data-lightbox-caption]');
    const prevButton = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
    const nextButton = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-next]');
    const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-lightbox-close]');

    if (dialog && image && caption && prevButton && nextButton && closeButton) {
      const triggers = () =>
        Array.from(
          gallery.querySelectorAll<HTMLElement>('[data-photo-src]')
        );

      let currentIndex = 0;

      const showAt = (index: number) => {
        const items = triggers();
        if (items.length === 0) return;

        // Wrap so the archive-style continuous browse works at both ends.
        currentIndex = ((index % items.length) + items.length) % items.length;
        const item = items[currentIndex];
        const src = item.dataset.photoSrc;
        if (!src) return;

        const file = item.dataset.photoFile ?? src.split('/').pop() ?? '';
        const position = currentIndex + 1;
        const thumbnail = item.querySelector('img');

        image.src = src;
        image.alt = thumbnail?.alt ?? `Photo ${position} of ${items.length}`;
        caption.textContent = `${position} / ${items.length} — ${file}`;

        // Reveal the batch that contains this photo if the user navigated into
        // a still-hidden "show more" range via next/prev.
        const batch = item.closest<HTMLElement>('[data-batch]');
        if (batch?.hidden) {
          batch.hidden = false;
          const batchIndex = Number(batch.dataset.batch ?? 0);
          if (batchIndex + 1 > revealed) revealed = batchIndex + 1;
          const shown = gallery.querySelectorAll(
            '[data-batch]:not([hidden]) [data-photo-src]'
          ).length;
          if (count) count.textContent = `Showing ${shown} of ${total}`;
          if (revealed >= batches.length && moreBox) moreBox.hidden = true;
        }
      };

      const openAt = (index: number) => {
        showAt(index);
        if (!dialog.open) dialog.showModal();
        nextButton.focus();
      };

      gallery.addEventListener('click', (event) => {
        const trigger = (event.target as HTMLElement).closest<HTMLElement>(
          '[data-photo-src]'
        );
        if (!trigger) return;

        const items = triggers();
        const index = items.indexOf(trigger);
        if (index < 0) return;
        openAt(index);
      });

      prevButton.addEventListener('click', () => showAt(currentIndex - 1));
      nextButton.addEventListener('click', () => showAt(currentIndex + 1));
      closeButton.addEventListener('click', () => dialog.close());

      dialog.addEventListener('keydown', (event) => {
        if (!dialog.open) return;
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          showAt(currentIndex - 1);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          showAt(currentIndex + 1);
        }
      });

      // Backdrop click closes. Native <dialog> already maps Escape to close.
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      dialog.addEventListener('close', () => {
        image.removeAttribute('src');
        const opener = triggers()[currentIndex];
        opener?.focus();
      });
    }
  }

  bindGallery();
  document.addEventListener('astro:page-load', bindGallery);
</script>
