---
import site from '../data/site.json';

interface Props {
  title: string;
  description?: string;
  /** Path under /og/, e.g. "default.png". Generated by `npm run og`. */
  ogImage?: string;
  /** Set on pages that should not be indexed (e.g. the 404). */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = 'default.png',
  noindex = false,
} = Astro.props;

const fullTitle =
  title === site.shortName ? title : `${title} | ${site.shortName}`;

// Astro.site is configured from the SITE env var, so canonical and og:url are
// correct whether this builds at a domain root or under a demo subpath.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(
  `${import.meta.env.BASE_URL.replace(/\/$/, '')}/og/${ogImage}`,
  Astro.site
).href;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.legalName,
  alternateName: site.shortName,
  url: Astro.site?.href,
  description: site.description,
  email: site.emails.enquiries,
  areaServed: 'NZ',
  sameAs: site.socials.map((s) => s.href),
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.shortName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_NZ" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(organizationSchema)}
/>
