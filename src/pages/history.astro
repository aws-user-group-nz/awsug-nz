---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonList from '../components/PersonList.astro';
import Icon from '../components/Icon.astro';
import pastCommittees from '../data/past-committees.json';
import { pastCommitteeYears, withDefaultRole } from '../lib/history';

const page = await getEntry('pages', 'history');
if (!page) throw new Error('Missing content/pages/history.md');
const { Content } = await render(page);

/**
 * Prior years from past-committees.json (year-first).
 * Current committee stays on About. Role omitted → Member.
 */
const years = pastCommitteeYears(pastCommittees).map((entry) => ({
  ...entry,
  people: entry.people.map(withDefaultRole),
}));
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  ogImage={page.data.ogImage ?? 'about.png'}
>
  <div class="page">
    <div class="container">
      <div class="content-panel">
        <h1 class="page-title">{page.data.title}</h1>
        {page.data.lede && <p class="lede">{page.data.lede}</p>}
        <div class="prose">
          <Content />
        </div>

        <div class="people-block">
          <h2 class="section-title" id="past-committee">Past committee</h2>
          <p class="year-lede">
            Prior years only — the current committee is on About. Roles come
            next from AGM records.
          </p>

          <div class="year-list">
            {
              years.map((entry, index) => (
                <details class="year" open={index === 0}>
                  <summary>
                    <span class="year-summary-inner">
                      <span class="year-label">{entry.year}</span>
                      <Icon name="chevron" size="sm" class="year-chevron" />
                    </span>
                  </summary>
                  <div class="year-body">
                    <PersonList people={entry.people} variant="table" />
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-7);
  }

  .page-title + .lede {
    margin-bottom: var(--space-5);
  }

  .lede + .prose,
  .page-title + .prose {
    margin-top: var(--space-5);
  }

  .people-block {
    margin-top: var(--space-8);
  }

  .people-block .section-title {
    margin-top: var(--space-7);
  }

  .year-lede {
    margin: calc(-1 * var(--space-3)) 0 var(--space-5);
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .year-list {
    border-top: 1px solid var(--border);
  }

  .year {
    border-bottom: 1px solid var(--border);
  }

  .year :global(summary) {
    cursor: pointer;
    list-style: none;
    padding-block: var(--space-4);
    border-radius: var(--radius-sm);
  }

  .year :global(summary::-webkit-details-marker) {
    display: none;
  }

  .year :global(summary:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .year-summary-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    width: 100%;
  }

  .year-label {
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .year-chevron {
    color: var(--text-secondary);
    transition: transform var(--transition-fast);
  }

  .year[open] .year-chevron {
    transform: rotate(180deg);
  }

  .year :global(summary:hover) .year-label,
  .year :global(summary:focus-visible) .year-label {
    color: var(--accent-text);
  }

  .year-body {
    padding-bottom: var(--space-5);
  }
</style>
